generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoginType {
  EMAIL
  GOOGLE
  GITHUB
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  fullName         String?
  role             UserRole  @default(USER)
  password         String?
  loginType        LoginType @default(EMAIL)
  googleId         String?   @unique
  githubId         String?   @unique
  profilePicture   String?
  isEmailVerified  Boolean   @default(false)
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")

  otpLogs      OtpLog[]
  diaryEntries DiaryEntry[]
  adminProfile Admin?
}

model DiaryEntry {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  entryDate       DateTime

  title           String
  contentRaw      String     // user’s original writing
  contentAI       String?    // AI-enhanced version (optional)
  mood            String?    // e.g., Happy, Sad, Calm, Motivated, etc.
  moodIntensity   Int?       // scale 1–10 (optional)
  diaryType       DiaryType  @default(NORMAL)
  tags            String[]   // e.g., ["work", "friends", "travel"]
  mediaUrls       String[]   // images or video links (Cloudinary or similar)
  location        String?    // optional (city, or general area)
  isLocked        Boolean    @default(false)
  passwordHint    String?    // optional hint for locked entries
  aiSummary       String?    // auto-generated summary for flashbacks
  aiKeywords      String[]   // extracted key topics for future search

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, entryDate])

}

enum DiaryType {
  NORMAL
  SECRET
  MEMORY
  QUICK_NOTE
}

model OtpLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  otpType   String
  attempts  Int      @default(0)
  success   Boolean
  createdAt DateTime @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  permissions  String[] @default([])
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
}
